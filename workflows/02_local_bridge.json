      },
      "position": [
        300,
        0
      ],
      "typeVersion": 4.2,
      "onError": "continueErrorOutput"
    },
    {
      "id": "19d1e8b1-6fa5-4027-92bb-1d15392cf0e7",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": "={{ $json.http_status || 200 }}"
        }
      },
      "position": [
        1740,
        100
      ],
      "typeVersion": 1.4
    },
    {
      "id": "ac7b5eee-9ca1-477e-8a5d-66ac2af53dcb",
      "name": "Service Unavailable",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "jsCode": "return [{json:{ok:false,http_status:503,error:{code:'service_unavailable',message:'เชื่อมต่อแหล่งข้อมูลหรือบันทึกไม่สำเร็จ ยังยืนยันผลไม่ได้ กรุณาค้นหารายการก่อนลองใหม่'}}}];"
      },
      "position": [
        600,
        200
      ],
      "typeVersion": 2
    }
  ],
